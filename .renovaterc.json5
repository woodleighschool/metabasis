{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>woodleighschool/renovate-config",
    "local>woodleighschool/renovate-config:autoMerge.json5",
  ],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
  packageRules: [
    {
      matchManagers: ["npm"],
      minimumReleaseAge: "12 hours",
    },
  ],
}
